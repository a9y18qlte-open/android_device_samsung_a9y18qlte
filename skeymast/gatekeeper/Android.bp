// SPDX-License-Identifier: Apache-2.0
// OSS MDFPP gatekeeper module for a9y18qlte (talks to skeymast TA).
//
// Replaces Samsung's gatekeeper.mdfpp.so under the same name, selected by
// ro.hardware.gatekeeper=mdfpp. libQSEEComAPI is the stock vendor prebuilt
// (closed); the shared transport/codec lives in libskeymast_common.
//
// Links the current platform BoringSSL (CBB/CBS) built in tree, so it needs
// none of the libcrypto-v33 pin the stock blob did.

cc_library_shared {
    name: "gatekeeper.mdfpp",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",

    srcs: ["gatekeeper_mdfpp.c"],

    static_libs: ["libskeymast_common"],

    shared_libs: [
        "liblog",
        "libcrypto",
        "libQSEEComAPI",
    ],

    header_libs: ["libhardware_headers"],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
