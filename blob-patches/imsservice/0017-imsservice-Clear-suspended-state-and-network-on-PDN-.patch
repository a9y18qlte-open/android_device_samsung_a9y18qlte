     .line 463
+    sget-object v0, Lcom/sec/internal/ims/imsservice/RegisterTask$RegisterTaskState;->IDLE:Lcom/sec/internal/ims/imsservice/RegisterTask$RegisterTaskState;
+
+    if-ne p1, v0, :cond_0
+
+    .line 464
+    const/4 v0, 0x0
+
+    iput-boolean v0, p0, Lcom/sec/internal/ims/imsservice/RegisterTask;->mSuspended:Z
+
+    iput-object v0, p0, Lcom/sec/internal/ims/imsservice/RegisterTask;->mNetworkConnected:Landroid/net/Network;
+
+    .line 466
+    :cond_0
     return-void
 .end method
 
