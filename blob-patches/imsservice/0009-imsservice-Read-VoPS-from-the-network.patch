From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Nguyen <tienthong2004@gmail.com>
Date: Thu, 1 Oct 2026 13:52:41 +0000
Subject: [PATCH 09/15] imsservice: Read VoPS from the network

samsung-ims-patches stage 07 stubbed
ServiceStateWrapper.getLteImsVoiceAvail() to always report VoPS
supported, as the Samsung ServiceState fields it reads do not exist on
AOSP. The stack then registers on networks that told the phone VoPS is
not supported, e.g. a SIM without VoLTE: with no P-CSCF the REGISTER goes
nowhere until Timer F, and meanwhile the other slot cannot register.

Read the value from AOSP's LteVopsSupportInfo instead and pass on an
explicit "not supported"; anything else keeps reporting supported. Such a
slot now logs "NOT_TRIGGERED : VOPS_OFF" and the other slot registers
right away. tools/imsservice/fix_vops.py applies it.

Assisted-by: LLM
---
 .../ims/util/os/ServiceStateWrapper.smali     | 43 ++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/smali/com/sec/internal/ims/util/os/ServiceStateWrapper.smali b/smali/com/sec/internal/ims/util/os/ServiceStateWrapper.smali
index ed2a308..ea1de9a 100644
--- a/smali/com/sec/internal/ims/util/os/ServiceStateWrapper.smali
+++ b/smali/com/sec/internal/ims/util/os/ServiceStateWrapper.smali
@@ -311,10 +311,51 @@
 .end method
 
 .method public getLteImsVoiceAvail()I
-    .locals 1
+    .locals 4
 
     const/4 v0, 0x2
 
+    iget-object v1, p0, Lcom/sec/internal/ims/util/os/ServiceStateWrapper;->mServiceState:Landroid/telephony/ServiceState;
+
+    if-eqz v1, :cond_0
+
+    :try_start_0
+    const/4 v2, 0x2
+
+    const/4 v3, 0x1
+
+    invoke-virtual {v1, v2, v3}, Landroid/telephony/ServiceState;->getNetworkRegistrationInfo(II)Landroid/telephony/NetworkRegistrationInfo;
+
+    move-result-object v1
+
+    if-eqz v1, :cond_0
+
+    invoke-virtual {v1}, Landroid/telephony/NetworkRegistrationInfo;->getDataSpecificInfo()Landroid/telephony/DataSpecificRegistrationInfo;
+
+    move-result-object v1
+
+    if-eqz v1, :cond_0
+
+    invoke-virtual {v1}, Landroid/telephony/DataSpecificRegistrationInfo;->getLteVopsSupportInfo()Landroid/telephony/LteVopsSupportInfo;
+
+    move-result-object v1
+
+    if-eqz v1, :cond_0
+
+    invoke-virtual {v1}, Landroid/telephony/LteVopsSupportInfo;->getVopsSupport()I
+
+    move-result v1
+    :try_end_0
+    .catch Ljava/lang/Throwable; {:try_start_0 .. :try_end_0} :catch_0
+
+    const/4 v2, 0x3
+
+    if-ne v1, v2, :cond_0
+
+    move v0, v1
+
+    :catch_0
+    :cond_0
     return v0
 .end method
 
