// Android 10 entry points used by Samsung's SVE blobs (sveservice, the engine for
// VoWiFi calls). libsamsung_videoengine_9_0.so calls Camera and Surface methods
// whose signatures changed in Android 11/12; libsveservice.so and the video engine
// also use Parcel and GraphicBufferMapper methods Android 14 changed.

cc_library_shared {
    name: "libsve_shim",
    srcs: ["sve_shim.cpp"],
    header_libs: [
        "libmedia_headers",
        "libmediametrics_headers",
    ],
    shared_libs: [
        "libbinder",
        "libcamera_client",
        "libcameracompatbilityinfo",
        "libgui",
        "libui",
        "libutils",
        "framework-permission-aidl-cpp",
    ],
    compile_multilib: "64",
}
