// Android 10 entry points used by Samsung's SVE blobs (sveservice, the audio engine
// for VoWiFi calls). libAudioFWInterface.so and libsamsung_videoengine_9_0.so call
// AudioRecord, Camera and Surface methods whose signatures changed in Android 11/12.

cc_library_shared {
    name: "libsve_shim",
    srcs: ["sve_shim.cpp"],
    header_libs: [
        "libaudioclient_headers",
        "libmedia_headers",
        "libmediametrics_headers",
    ],
    shared_libs: [
        "audioclient-types-aidl-cpp",
        "libaudioclient",
        "libaudiofoundation",
        "libbinder",
        "libcamera_client",
        "libgui",
        "libutils",
        "framework-permission-aidl-cpp",
    ],
    compile_multilib: "64",
}
