cc_library_shared {
    name: "libAudioFWInterface",
    srcs: ["AudioFWInterface.cpp"],
    header_libs: [
        "libaudioclient_headers",
        "libmedia_headers",
        "libmediametrics_headers",
    ],
    shared_libs: [
        "audioclient-types-aidl-cpp",
        "framework-permission-aidl-cpp",
        "libaudioclient",
        "libaudiofoundation",
        "libbinder",
        "liblog",
        "libutils",
    ],
    compile_multilib: "64",
}
