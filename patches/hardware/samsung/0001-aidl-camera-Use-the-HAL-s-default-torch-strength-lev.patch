From 579b08e44cba374981cc18066c33a828173f7fc3 Mon Sep 17 00:00:00 2001
From: James Nguyen <tienthong2004@gmail.com>
Date: Mon, 12 Oct 2026 17:10:45 +0700
Subject: [PATCH] aidl: camera: Use the HAL's default torch strength level

The provider forced the torch strength level to 1 on every plain torch
on/off and at start, and replaced the strength keys the HAL reported
with a fixed 5 levels and default level 1. A HAL that reports its own
default level then fails CTS FlashlightTest, which expects
getTorchStrengthLevel() to return FLASH_INFO_STRENGTH_DEFAULT_LEVEL
after the torch turns off.

Keep the HAL's strength keys when it reports them, and reset the level
to the default level it reports. HALs without the keys keep 5 levels
and default level 1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 aidl/camera/device/CameraDevice.cpp | 24 +++++++++++++++++++++---
 aidl/camera/device/CameraDevice.h   |  1 +
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/aidl/camera/device/CameraDevice.cpp b/aidl/camera/device/CameraDevice.cpp
index 65cba8d..f2475f2 100644
--- a/aidl/camera/device/CameraDevice.cpp
+++ b/aidl/camera/device/CameraDevice.cpp
@@ -39,7 +39,23 @@ CameraDevice::CameraDevice(
     if (mDeviceVersion < CAMERA_DEVICE_API_VERSION_3_2) {
         ALOGE("%s: Camera id %s does not support HAL3.2+", __FUNCTION__, mCameraId.c_str());
         mInitFail = true;
+        return;
+    }
+
+    // Plain torch on/off resets the strength level to the default level the
+    // HAL reports, if it reports one.
+    struct camera_info info;
+    if (mModule->getCameraInfo(mCameraIdInt, &info) == OK &&
+        info.static_camera_characteristics != NULL) {
+        camera_metadata_ro_entry_t entry;
+        if (find_camera_metadata_ro_entry(info.static_camera_characteristics,
+                                          ANDROID_FLASH_INFO_STRENGTH_DEFAULT_LEVEL,
+                                          &entry) == OK &&
+            entry.count > 0) {
+            mTorchDefaultStrengthLevel = entry.data.i32[0];
+        }
     }
+    mTorchStrengthLevel = mTorchDefaultStrengthLevel;
 }
 
 CameraDevice::~CameraDevice() {}
@@ -68,8 +84,10 @@ ndk::ScopedAStatus CameraDevice::getCameraCharacteristics(CameraMetadata* _aidl_
         if (ret == OK && info.static_camera_characteristics != NULL) {
             common::helper::CameraMetadata metadata = (camera_metadata_t*)info.static_camera_characteristics;
             camera_metadata_entry_t entry = metadata.find(ANDROID_FLASH_INFO_AVAILABLE);
-            if (entry.count > 0 && *entry.data.u8 != 0 && mModule->isSetTorchModeStrengthSupported()) {
-                // Samsung always has 5 supported torch strength levels
+            if (entry.count > 0 && *entry.data.u8 != 0 && mModule->isSetTorchModeStrengthSupported() &&
+                metadata.find(ANDROID_FLASH_INFO_STRENGTH_MAXIMUM_LEVEL).count == 0) {
+                // Samsung always has 5 supported torch strength levels, unless
+                // the HAL reports its own
                 int32_t defaultTorchStrength = 1;
                 int32_t torchStrengthLevels = 5;
                 metadata.update(ANDROID_FLASH_INFO_STRENGTH_DEFAULT_LEVEL, &defaultTorchStrength, 1);
@@ -358,7 +376,7 @@ ndk::ScopedAStatus CameraDevice::setTorchMode(bool in_on) {
     if (status == Status::OK) {
         status = getAidlStatus(mModule->setTorchMode(mCameraId.c_str(), in_on));
         if (status == Status::OK) {
-            mTorchStrengthLevel = 1;
+            mTorchStrengthLevel = mTorchDefaultStrengthLevel;
         }
     }
     return fromStatus(status);
diff --git a/aidl/camera/device/CameraDevice.h b/aidl/camera/device/CameraDevice.h
index 61f4e8c..3597496 100644
--- a/aidl/camera/device/CameraDevice.h
+++ b/aidl/camera/device/CameraDevice.h
@@ -79,6 +79,7 @@ class CameraDevice : public BnCameraDevice {
     // Set by provider (when external camera is connected/disconnected)
     bool mDisconnected;
     std::weak_ptr<CameraDeviceSession> mSession{};
+    int32_t mTorchDefaultStrengthLevel = 1;
     int32_t mTorchStrengthLevel = 1;
 
     const SortedVector<std::pair<std::string, std::string>>& mCameraDeviceNames;
-- 
