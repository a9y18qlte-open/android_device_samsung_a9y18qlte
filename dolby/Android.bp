cc_library_shared {
    name: "libstagefright_soft_ac4dec",
    srcs: ["ac4dec_shim.cpp"],
    header_libs: ["media_plugin_headers"],
    shared_libs: ["liblog"],
    compile_multilib: "32",
    vendor: true,
}

cc_library_shared {
    name: "libstagefright_omx_vendor",
    srcs: ["omx_vendor.c"],
    compile_multilib: "32",
    vendor: true,
}

cc_library_shared {
    name: "libstagefright_softomx_plugin_dolby",
    stem: "libstagefright_softomx_plugin",
    srcs: ["DolbyOMXPlugin.cpp"],
    shared_libs: [
        "libstagefright_softomx",
        "liblog",
        "libutils",
    ],
    compile_multilib: "32",
    vendor: true,
    installable: false,
}

cc_prebuilt_library_shared {
    name: "libstagefright_softomx_plugin",
    srcs: [":libstagefright_softomx_plugin_dolby"],
    shared_libs: [
        "libstagefright_softomx",
        "liblog",
        "libutils",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "32",
    prefer: true,
    vendor_available: true,
}
