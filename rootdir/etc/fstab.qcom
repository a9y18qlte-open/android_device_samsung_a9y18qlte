# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

# Non-A/B fstab.qcom variant
#<src>                                   <mnt_point>            <type> <mnt_flags and options>                          <fs_mgr_flags>
/dev/block/platform/soc/1da4000.ufshc/by-name/system /system    ext4   ro,barrier=1,discard                           wait,first_stage_mount
/dev/block/platform/soc/1da4000.ufshc/by-name/vendor /vendor    ext4   ro,barrier=1,discard                           wait,first_stage_mount
/dev/block/bootdevice/by-name/boot             /boot    emmc   defaults                                         defaults
/dev/block/bootdevice/by-name/recovery         /recovery emmc  defaults                                         defaults
# /data uses file-based encryption through the Qualcomm inline crypto engine.
# The kernel provides it: CONFIG_PFK=y, CONFIG_CRYPTO_DEV_QCOM_ICE=y,
# CONFIG_SCSI_UFS_QCOM_ICE=y and CONFIG_EXT4_ENCRYPTION=y, and ext4 reports
# encryption as supported. Key management runs through qseecomd, the same QSEE
# path the gatekeeper uses.
#
# There is no metadata partition on this board, so this is FBE only - metadata
# encryption is not available.
#
# Verified working: ro.crypto.state=encrypted, ro.crypto.type=file, with VoLTE
# re-registering from a freshly formatted partition. Tested in permissive - the
# enforcing bootloop this was first blamed for was caused by enforcing alone.
#
# NOTE: /data must be formatted when this is first applied. Existing plaintext
# files cannot be encrypted in place.
/dev/block/bootdevice/by-name/userdata	/data	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=continue	wait,check,quota,reservedsize=128M,fileencryption=ice
/dev/block/bootdevice/by-name/misc        /misc                  emmc   defaults                                         defaults
#/dev/block/bootdevice/by-name/modem      /vendor/firmware_mnt  vfat   ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
#/dev/block/bootdevice/by-name/bluetooth  /vendor/bt_firmware    vfat   ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait
#/dev/block/bootdevice/by-name/dsp        /vendor/dsp            ext4   ro,nosuid,nodev,barrier=1                        wait
/dev/block/bootdevice/by-name/cache      /cache                 ext4   nosuid,nodev,noatime,barrier=1                           wait
#/dev/block/bootdevice/by-name/persist    /mnt/vendor/persist    ext4   noatime,nosuid,nodev,barrier=1                   wait
/dev/block/zram0                         none        swap   defaults    zramsize=2147483648

# VOLD :: fstab_non_AB_variant.qcom
/dev/block/bootdevice/by-name/efs	/efs	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=continue	voldmanaged=efs:auto,check
/devices/soc/c084000.sdhci/mmc_host*                        auto                vfat        defaults    voldmanaged=sdcard:auto
/devices/soc/a800000.ssusb/a800000.dwc3/xhci-hcd.0.auto*    auto                auto        defaults    voldmanaged=usb:auto
