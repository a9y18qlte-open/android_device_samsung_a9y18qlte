soong_namespace {
    // Allow device-tree modules (e.g. the OSS skeymast HALs) to depend on the
    // vendor prebuilts in vendor/samsung/a9y18qlte, such as libQSEEComAPI,
    // and the camera provider on the camera libraries of hardware/samsung.
    imports: [
        "hardware/samsung",
        "vendor/samsung/a9y18qlte",
    ],
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}
