soong_namespace {
    // Allow device-tree modules (e.g. the OSS skeymast HALs) to depend on the
    // vendor prebuilts in vendor/samsung/a9y18qlte, such as libQSEEComAPI.
    imports: [
        "vendor/samsung/a9y18qlte",
    ],
}

prebuilt_etc_xml {
    name: "compat_framework_overrides.xml",
    src: "configs/compat_framework_overrides.xml",
    sub_dir: "appcompat",
    product_specific: true,
}
