// CameraX / Camera2 extensions vendor library (androidx.camera.extensions.impl),
// based on frameworks/ex/camera2/extensions/sample. Offers bokeh, which the camera
// HAL renders, and HDR, an exposure bracket fused here.
java_library {
    name: "androidx.camera.extensions.impl.a9y18qlte",
    installable: true,
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    vendor: true,
}

prebuilt_etc {
    name: "camera_extensions_a9y18qlte.xml",
    src: "camera_extensions.xml",
    sub_dir: "permissions",
    vendor: true,
}
