cc_library_shared {
    name: "camera.unihal.default",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    srcs: ["camera_wrapper.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libcamera_metadata",
        "libdl",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
