# Fingerprint sensor
type sec_fingerprint_device, dev_type;
allow hal_fingerprint_default sec_fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;

# time_daemon
allow time_daemon sysfs:file r_file_perms;
allow time_daemon self:socket { create read write ioctl };
allowxperm time_daemon self:socket ioctl { 0xc302 0xc304 };

# init sysfs nodes
allow init { sysfs_batteryinfo sysfs_ufs }:file { write setattr };
