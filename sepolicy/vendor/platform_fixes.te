# sysfs subsystem and UIO names
type sysfs_subsys, sysfs_type, fs_type;
allow { rmt_storage thermal-engine wcnss_service hal_sensors_default time_daemon
        vendor_pd_mapper vendor_per_mgr sensors atfwd
        factory_adsp }
      sysfs_subsys:dir search;
allow { rmt_storage thermal-engine wcnss_service hal_sensors_default time_daemon
        vendor_pd_mapper vendor_per_mgr sensors atfwd
        factory_adsp }
      sysfs_subsys:file r_file_perms;

# SPMI / PMIC
type sysfs_spmi, sysfs_type, fs_type;
allow hvdcp sysfs_spmi:dir r_dir_perms;
allow hvdcp sysfs_spmi:file r_file_perms;
allow hvdcp sysfs_batteryinfo:dir search;

allow system_server sysfs_rtc:dir search;
allow system_server sysfs_rtc:file r_file_perms;

# Sensors
allow hal_sensors_default sysfs_sensors:dir r_dir_perms;
allow hal_sensors_default sysfs_sensors:file r_file_perms;
r_dir_file(sensors, app_efs_file)
allow sensors app_efs_file:file { write setattr };
allow sensors efs_file:dir getattr;

# Thermal engine
allow thermal-engine sysfs_batteryinfo:dir search;
allow thermal-engine self:capability2 wake_alarm;

# QTI init shell
allow qti_init_shell sysfs_thermal:file rw_file_perms;
allow qti_init_shell sysfs_devices_system_cpu:file setattr;

type sysfs_volkey, sysfs_type, fs_type;
allow qti_init_shell sysfs_volkey:file { setattr write };

# Audio
allow hal_audio_default sysfs:dir r_dir_perms;
allow hal_audio_default efs_file:dir search;

# Properties
get_prop(sec_proca, hwservicemanager_prop)
get_prop(sec_wsm, hwservicemanager_prop)
get_prop(mediacodec, vendor_audio_prop)

# Samsung PTA device
allow energyawareness pta_device:chr_file rw_file_perms;

# Wi-Fi boot sysfs
type sysfs_wlan_boot, sysfs_type, fs_type;
allow { init macloader } sysfs_wlan_boot:dir r_dir_perms;
allow { init macloader } sysfs_wlan_boot:file rw_file_perms;

allow macloader wifi_vendor_data_file:dir rw_dir_perms;
allow macloader wifi_vendor_data_file:file create_file_perms;

# secril_config
allow secril_config mnt_vendor_file:dir search;
allow secril_config efs_file:dir search;
allow secril_config efs_file:file r_file_perms;

# qseecomd wrapper
get_prop(qseecomd_sh, vendor_tee_listener_prop)

# NFC device node
allow hal_nfc_default nfc_device:chr_file rw_file_perms;
dontaudit hal_nfc_default default_android_hwservice:hwservice_manager find;

# Block devices
type ssd_block_device, dev_type;
type modem_efs_block_device, dev_type;
allow rmt_storage modem_efs_block_device:blk_file rw_file_perms;
allow tee ssd_block_device:blk_file rw_file_perms;

allow tee persist_file:lnk_file r_file_perms;
allow vendor_init persist_file:lnk_file r_file_perms;

# msm_core
type sysfs_msm_core, sysfs_type, fs_type;
allow { init energyawareness } sysfs_msm_core:dir search;
allow { init energyawareness } sysfs_msm_core:file rw_file_perms;

# Wi-Fi EFS
type wifi_efs_file, file_type, data_file_type;
r_dir_file(macloader, wifi_efs_file)
allow macloader wifi_efs_file:dir write;
allow macloader wifi_efs_file:file create_file_perms;

# UFS host controller
type sysfs_ufs, sysfs_type, fs_type;
allow hal_perf_default sysfs_ufs:dir search;
allow hal_perf_default sysfs_ufs:file r_file_perms;

# Kernel log
allow qti_init_shell kmsg_device:chr_file { open write };

# Modem filesystem cache
allow rmt_storage modem_efs_block_device:blk_file rw_file_perms;

# macloader
allow macloader self:udp_socket { create ioctl };
allow macloader self:capability { net_admin sys_module };

# vold
allow vold sysfs_ufs:file write;

# secril_config
set_prop(secril_config, vendor_radio_prop)
set_prop(secril_config, radio_control_prop)

# PMIC brightness
allow init sysfs_spmi:file setattr;

# Gatekeeper credential storage
typeattribute tee data_between_core_and_vendor_violators;
allow tee gatekeeper_data_file:dir rw_dir_perms;
allow tee gatekeeper_data_file:file create_file_perms;

# Health HAL
allow hal_health_default efs_file:dir search;

# Sensors HAL & daemon
allow sensors efs_file:dir search;
allow sensors persist_file:lnk_file r_file_perms;
allow hal_sensors_default persist_file:lnk_file r_file_perms;
allow macloader efs_file:dir search;

# QTI init shell
allow qti_init_shell { sysfs sysfs_msm_power }:file setattr;
allow qti_init_shell persist_file:lnk_file read;

# Factory ADSP
allow factory_adsp persist_file:lnk_file r_file_perms;
allow factory_adsp mnt_vendor_file:dir search;
allow factory_adsp diag_device:chr_file rw_file_perms;

# GNSS
dontaudit hal_gnss_qti { radio_prop default_prop }:file read;

# RIL & Telephony
dontaudit rild radio_core_data_file:dir search;
dontaudit secril_config { radio_prop default_prop }:file read;

# Camera & Graphics
allow hal_graphics_composer_default sysfs_camera:dir search;
dontaudit hal_camera_default { default_prop radio_prop bootanim_system_prop persist_debug_prop }:file read;

# Bluetooth & Audio
allow hal_bluetooth_qti efs_file:dir search;
dontaudit hal_audio_default radio_prop:file read;

# Daemon dontaudits
dontaudit multiclientd system_data_file:dir search;
dontaudit hal_nfc_default system_file:file read;

# SurfaceFlinger
allow surfaceflinger hal_graphics_composer_default:dir search;

# Thermal HAL
allow hal_thermal_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow hal_thermal_default sysfs_thermal:file rw_file_perms;

# WCNSS WiGig property dontaudit
dontaudit wcnss_service vendor_wigig_core_prop:file read;

# Camera provider
hal_client_domain(hal_camera_default, hal_graphics_allocator)
get_prop(hal_camera_default, camera_config_prop)

# Bluetooth HAL
dontaudit hal_bluetooth_qti default_prop:file read;

# secril_config
dontaudit secril_config { default_prop vendor_default_prop radio_control_prop }:property_service set;
