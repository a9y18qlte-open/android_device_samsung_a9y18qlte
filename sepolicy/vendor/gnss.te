# GNSS
allow { hal_gnss_qti location } self:socket { create read write ioctl };
allowxperm { hal_gnss_qti location } self:socket ioctl { 0xc302 0xc304 };

allow { hal_gnss_qti location } sysfs_subsys:dir search;
allow { hal_gnss_qti location } sysfs_subsys:file r_file_perms;

allow hal_gnss_qti sysfs_batteryinfo:dir search;
allow hal_gnss_qti sysfs_batteryinfo:file r_file_perms;
