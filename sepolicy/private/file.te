type sysfs_sec_key, sysfs_type, fs_type;
# Samsung USB path switch. smdexe reads usb_sel from here, and coredomain.te
# forbids a core domain from touching unlabelled kernel interfaces.
type sysfs_sec_switch, sysfs_type, fs_type;

# sysfs_wlan_boot moved to sepolicy/vendor: macloader needs it too and is a
# vendor domain, while init is plat-public and can be named from either side.
# sysfs_msm_core moved to sepolicy/vendor: energyawareness needs it and is a
# vendor domain.

# /dev/block/sda12, by-name "persistent", is the FRP partition. It uses the
# stock frp_block_device type - system_server.te neverallows system_server any
# other block device, so a custom type here would be rejected.
# /dev/block/sda28, by-name "debug".
type sec_debug_block_device, dev_type;

# /data/log/imscr - the IMS call-recording log, written by the Samsung IMS app
# and imsd. app.te neverallows appdomain writing system_data_file and says to
# "define a different type for portions that should be writable by apps".
type ims_log_data_file, file_type, data_file_type, core_data_file_type;

# sysfs_rtc lives in sepolicy/vendor: the RTC hangs off the SPMI tree, and its
# genfscon has to sit next to the SPMI one so the longer prefix wins.

# imsd's control socket, /dev/socket/imsd.
type imsd_socket, file_type;
type proc_touchpanel, fs_type;
type sysfs_lcd_writable, sysfs_type, fs_type;
# wifi_efs_file moved to sepolicy/vendor: macloader needs it and is a vendor
# domain, same as app_efs_file and imei_efs_file before it.
# imei_efs_file moved to sepolicy/vendor/samsung_hals.te alongside
# app_efs_file: rild reads both and is a vendor domain.
# app_efs_file moved to sepolicy/vendor/samsung_hals.te: the only domain that
# needs it is hal_health_default, which is a vendor domain, and vendor policy
# cannot see types declared in plat_private.

# connfwexe's packet-capture control socket, /data/.tcpdump_socket.
type tcpdump_socket_file, file_type, data_file_type, core_data_file_type;
