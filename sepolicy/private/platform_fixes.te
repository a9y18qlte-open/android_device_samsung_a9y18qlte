# init
allow init self:capability sys_module;
allow init proc:file write;
allow init efs_file:dir mounton;

# FRP / persistent partition
allow system_server frp_block_device:blk_file rw_file_perms;
allow system_server shell:unix_stream_socket getopt;

# Block partitions
allow fsck userdata_block_device:blk_file rw_file_perms;
allow fsck cache_block_device:blk_file rw_file_perms;
allow kernel sec_debug_block_device:blk_file r_file_perms;

# vendor_init
allow vendor_init tmpfs:dir { add_name write };
allow vendor_init rootfs:file { getattr relabelfrom };
allow vendor_init cgroup:file getattr;

# Core domains
allow ueventd self:capability sys_nice;
allow vold rootfs:dir setattr;
allow migrate_legacy_obb_data self:capability sys_resource;
allow adbd shell:unix_stream_socket shutdown;
allow hwservicemanager multiclientd:binder transfer;
allow system_server proc_last_kmsg:file r_file_perms;

# connfwexe
allow connfwexe tcpdump_socket_file:sock_file { create unlink };
type_transition connfwexe system_data_file:sock_file tcpdump_socket_file ".tcpdump_socket";
allow connfwexe system_data_file:dir { write add_name remove_name };
dontaudit connfwexe system_data_root_file:dir write;
get_prop(connfwexe, hwservicemanager_prop)

allow connfwexe multiclientd:unix_stream_socket connectto;
allow hwservicemanager connfwexe:binder transfer;

# Samsung system app & IMS
allow system_app samsung_imsd:unix_stream_socket connectto;
allow system_app multiclientd:unix_stream_socket connectto;
allow system_app imsd_socket:sock_file write;
allow system_app ims_log_data_file:dir create_dir_perms;
allow system_app ims_log_data_file:file create_file_perms;
allow samsung_imsd ims_log_data_file:dir create_dir_perms;
allow samsung_imsd ims_log_data_file:file create_file_perms;
allow system_app proc_net:file r_file_perms;

# Enforcing mode fixes
allow platform_app bluetooth_data_file:dir getattr;
binder_call(bluetooth, gpuservice)
allow kernel block_device:dir search;

# Service manager IPC
allow connfwexe hwservicemanager:binder call;
allow multiclientd hwservicemanager:binder call;
binder_call(servicemanager, hal_power_default)

# Suspend wakeup stats collection
allow system_suspend { sysfs sysfs_batteryinfo sysfs_camera }:file r_file_perms;

# Logpersist capability dontaudit
dontaudit logpersist self:capability { dac_override dac_read_search };
