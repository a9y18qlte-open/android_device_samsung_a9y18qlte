// SPDX-License-Identifier: Apache-2.0
// OSS MDFPP gatekeeper module for a9y18qlte (talks to skeymast TA).
//
// Installs as gatekeeper.mdfpposs.so so the stock gatekeeper.mdfpp.so stays in
// place; select ours with ro.hardware.gatekeeper=mdfpposs, fall back by setting
// it to mdfpp. libQSEEComAPI is the stock vendor prebuilt (closed); the shared
// transport/codec lives in libskeymast_common.
//
// Links the current platform BoringSSL (CBB/CBS). Do NOT apply the
// libcrypto-v33 replace_needed fixup here: that shim is only for the PREBUILT
// mdfpp blobs (BoringSSL ABI frozen at A13). Built in tree, our codec matches
// the libcrypto it links; replacing gatekeeper also drops gatekeeper's v33 need.

cc_library_shared {
    name: "gatekeeper.mdfpposs",
    relative_install_path: "hw",
    vendor: true,

    srcs: ["gatekeeper_mdfpp.c"],

    static_libs: ["libskeymast_common"],

    shared_libs: [
        "liblog",
        "libcrypto",
        "libQSEEComAPI",
    ],

    header_libs: ["libhardware_headers"],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
