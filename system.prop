# Camera
persist.camera.HAL3.enabled=1

# Audio
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.disabled=true
vendor.audio.feature.a2dp_offload.enable=false

# Bluetooth
vendor.bluetooth.soc=cherokee
vendor.qcom.bluetooth.soc=cherokee
#ro.bluetooth.library_name=libbluetooth_qti.so
persist.vendor.btstack.enable.splita2dp=true
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxhd-aac

# Bluetooth profiles
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

# CNE
persist.vendor.cne.feature=1

# Netflix custom property
ro.netflix.bsp_rev=Q660-13149-1

# Qualcomm
ro.vendor.qti.va_aosp.support=1

# VoLTE / VT
#
# ImsManager.isVolteEnabledByPlatform() requires config_device_volte_available
# (set true in our framework overlay) AND the carrier config key
# KEY_CARRIER_VOLTE_AVAILABLE_BOOL. AOSP's CarrierConfig ships no entry for
# BSNL (MCC/MNC 40472) - dumpsys shows carrier_config_version_string empty and
# carrier_volte_available_bool=false - so the check fails even though the
# network advertises VoPS support (LteVopsSupportInfo mVopsSupport=1) and the
# Samsung ImsService reports MmTel Voice: true.
#
# These properties short-circuit that check in ImsManager (see
# frameworks/opt/net/ims/.../ImsManager.java, PROPERTY_DBG_VOLTE_AVAIL_OVERRIDE).
#
# DISABLED - do not re-enable until IMS actually registers.
#
# Forcing the platform flag only makes the framework *believe* VoLTE is usable;
# it does not make Samsung's IMS stack register. dumpsys secims shows
# "Update Feature [Registered: false]" and Samsung's own MNO config for this
# carrier says mnoname=BSNL_IN, Voice_Domain_Preference_EUTRAN=CSVoiceOnly,
# EnableVoLTEindicator=FALSE - i.e. the stack is configured not to do VoLTE here.
#
# With the override on, telephony routed calls to ImsPhoneCallTracker anyway.
# Calls stuck in DIALING forever with no progress and no terminate, so they could
# not even be hung up. That is worse than plain CSFB calling.
#
# The real fix is to make the Samsung IMS stack register (MNO voice-domain
# settings / the samsung-ims-patches stages), not to force the platform flag.
#persist.dbg.volte_avail_ovr=1
#persist.dbg.vt_avail_ovr=1

# Debugging
# adb now requires the host key to be authorised on the device. Takes effect on
# the next full build; the first adb connection after flashing will prompt on
# the handset before it will talk to a new machine.
persist.service.adb.enable=1
persist.sys.usb.config=adb

# IMS: let com.sec.imsservice's ImsSmsImpl take SMS over IMS itself; the legacy
# mode expects Samsung's telephony framework to register for them and never
# reports send results or incoming messages to AOSP. A radio_prop, which
# vendor_init may not set, so it lives here rather than in vendor.prop.
persist.radio.ims.legacysmsip.enabled=0
