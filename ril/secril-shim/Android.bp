cc_defaults {
    name: "libsec-ril-shim_defaults",
    vendor: true,
    compile_multilib: "64",
    srcs: ["secril-shim.c"],
    header_libs: ["ril_headers"],
    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],
    cflags: [
        "-DRIL_SHLIB",
        "-Wall",
        "-Werror",
    ],
}

cc_library_shared {
    name: "libsec-ril-shim",
    defaults: ["libsec-ril-shim_defaults"],
}

cc_library_shared {
    name: "libsec-ril-dsds-shim",
    defaults: ["libsec-ril-shim_defaults"],
    cflags: ["-DREAL_RIL_DSDS"],
}
