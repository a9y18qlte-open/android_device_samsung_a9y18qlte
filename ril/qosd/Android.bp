cc_binary {
    name: "qosd",
    vendor: true,
    srcs: ["qosd.c"],
    init_rc: ["qosd.rc"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
