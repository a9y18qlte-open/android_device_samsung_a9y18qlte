# Audio 
af.fast_track_multiplier=1
vendor.audio_hal.period_size=192
ro.vendor.audio.sdk.fluencetype=none
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.voicerec=false
persist.vendor.audio.fluence.speaker=true
vendor.audio.tunnel.encode=false
persist.vendor.audio.ras.enabled=false
vendor.audio.offload.buffer.size.kb=64
audio.offload.min.duration.secs=30
audio.offload.video=true
vendor.audio.offload.track.enable=true
audio.deep_buffer.media=true
vendor.voice.path.for.pcm.voip=true
vendor.audio.offload.multiaac.enable=true
vendor.audio.dolby.ds2.enabled=false
vendor.audio.dolby.ds2.hardbypass=false
vendor.audio.offload.multiple.enabled=false
vendor.audio.offload.passthrough=false
ro.vendor.audio.sdk.ssr=false
vendor.audio.offload.gapless.enabled=true
vendor.audio.safx.pbe.enabled=false
vendor.audio.parser.ip.buffer.size=262144
vendor.audio.flac.sw.decoder.24bit=true
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxhd-aac
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.disabled=true
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
vendor.audio.hw.aac.encoder=true
audio.sys.noisy.broadcast.delay=600
audio.sys.offload.pstimeout.secs=3
persist.vendor.audio.hifi.int_codec=true
ro.af.client_heap_size_kbyte=7168
persist.vendor.audio.hw.binder.size_kbyte=1024
audio.volume.headset.gain.depcal=true
persist.vendor.bt.aac_frm_ctl.enabled=true

vendor.audio.feature.compress_meta_data.enable=true
vendor.audio.feature.compr_voip.enable=true
vendor.audio.feature.deepbuffer_as_primary.enable=true
vendor.audio.feature.display_port.enable=true
vendor.audio.feature.fm.enable=true
vendor.audio.feature.hdmi_edid.enable=true
vendor.audio.feature.hfp.enable=true
vendor.audio.feature.spkr_prot.enable=true
vendor.audio.feature.usb_offload.enable=true
vendor.audio.feature.snd_mon.enable=true
vendor.audio.feature.multi_voice_session.enable=false
vendor.audio.feature.external_dsp.enable=false
vendor.audio.feature.external_speaker.enable=false
vendor.audio.feature.hwdep_cal.enable=false
vendor.audio.feature.concurrent_capture.enable=false
vendor.audio.feature.maxx_audio.enable=false
vendor.audio.feature.audiozoom.enable=false

# FRP 
    
# Graphics
debug.sf.enable_hwc_vds=1
debug.sf.hw=1
debug.sf.latch_unsignaled=1
debug.gralloc.enable_fb_ubwc=1

# Telephony
ro.telephony.default_network=10,10
persist.radio.multisim.config=dsds
ro.vendor.multisim.simslotcount=2

# Samsung specific
ro.product_ship=true
# Set csc support in OMX
# If not set or set to 0, OMX will only use BT.601 colorspace.
ro.vendor.cscsupported=1

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/persistent

# Sensors
ro.vendor.sensors.facing=false
ro.vendor.sensors.cmc=false
ro.vendor.sdk.sensors.gestures=false

# Samsung's gatekeeper HAL module is gatekeeper.mdfpp.so, but hw_get_module()
# probes ro.hardware.gatekeeper first and falls back to ro.hardware (qcom) and
# then "default" - none of which match. Without this the module is never found,
# and the HAL logs "Unable to open GateKeeper HAL, but keep going" then
# registers with a null device pointer. The first call segfaults it, gatekeeperd
# aborts on DEAD_OBJECT, and no lock credential can ever be stored.
ro.hardware.gatekeeper=mdfpp
ro.hardware.keystore=mdfpp

# Camera
persist.camera.HAL3.enabled=1
persist.vendor.camera.HAL3.enabled=1
# Camera1 API shim: skip the full-size ZSL/reprocess stream. It shares a VFE
# output with the JPEG stream and the combined buffer queue exceeds what
# msm_isp accepts ("Invalid buffer request"), so API1 apps get no preview.
camera.disable_zsl_mode=1

# RIL: libsec-ril behind ril/secril-shim
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril-shim.so
vendor.sec.rild.libpath2=/vendor/lib64/libsec-ril-dsds-shim.so

# IMS: route each SIM's IMS traffic to its own RIL (stock SEC_FLOATING_FEATURE_
# COMMON_CONFIG_DUAL_IMS, which com.sec.imsservice cannot read on AOSP)
persist.ril.config.dualims=DSDS_DI
